#include? "Pods/Target Support Files/Pods-Runner/Pods-Runner.release.xcconfig"
#include "Generated.xcconfig"

// Defaults for the iOS Release build. Internal/custom builds (e.g. an
// enterprise-signed distribution) override these without patching tracked
// files by writing `mobile/ios/Flutter/AppOverrides.xcconfig` (gitignored).
// The bundle identifier is assembled from a PREFIX so that a downstream or
// internal build can rename the app by overriding one variable, and the
// per-worktree debug identity below can append its slug to whatever prefix
// is in effect instead of hardcoding this default.
BUNDLE_ID_PREFIX = com.buzz.buzzMobile
BUNDLE_IDENTIFIER = $(BUNDLE_ID_PREFIX)
APP_DISPLAY_NAME = Buzz
CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY = iPhone Developer

// D-029 native push. The aps-environment entitlement declared here is what
// makes automatic signing create the explicit App ID for this build's bundle identifier with
// the Push capability enabled, instead of falling back to the team wildcard
// profile (which carries no aps-environment and leaves push dead at runtime).
CODE_SIGN_ENTITLEMENTS = Runner/Runner.entitlements
#include? "AppOverrides.xcconfig"
