# ============================================================================
# Buzz DEV relay environment for crichton — rendered by install-buzz-dev.sh.
# Written to $BUZZ_RUNTIME_DIR/buzz-dev.env, then symlinked/copied into the
# buzz checkout's deploy/compose/.env (which is where run.sh looks).
#
# 🔴 SECRETS LIVE HERE. Mode 0600. Back this file up — losing
#    BUZZ_RELAY_PRIVATE_KEY changes the relay's identity, and every member
#    registration is bound to it.
#    Buzz's own backup checklist: `deploy/compose/run.sh backup-hint`.
#
# Placeholders are substituted by the installer;
# any placeholder left unsubstituted is rejected before the relay starts —
# both by this kit and by buzz's own run.sh preflight.
# ============================================================================

# Pinned by digest, not `:main`. A moving tag cannot be rolled back to.
BUZZ_IMAGE=__BUZZ_IMAGE__

# ── Browser access ───────────────────────────────────────────────────────────
# 🔴 OFF BY DEFAULT UPSTREAM, and it decides whether a browser gets ANYTHING.
# With it false the relay answers `/` with the NIP-11 JSON document and 404s
# every other HTML path except `/invite/<code>`. With it true, `/`, `/repos`
# and `/repos/*` serve the bundled SPA.
#
# Note what that SPA IS: a **git web GUI** plus invite landing pages — not the
# full workspace client. The real client is the Tauri desktop app in the buzz
# checkout's `desktop/`, or `buzz-cli`. Turning this on gives you a browser
# smoke target and repo browsing; it does not give you channels and chat.
BUZZ_SERVE_GIT_WEB_GUI=true

# ── Front door ──────────────────────────────────────────────────────────────
# 🔴 THE HOST IS THE AUTHORITATIVE SELECTOR, AND IT INCLUDES THE PORT.
# The relay auto-provisions ONE community keyed on the host derived from
# RELAY_URL — measured: `crichton.tailb3d4b8.ts.net:6101`. Every request must
# arrive carrying EXACTLY that Host header or the relay answers
# `404 relay: no community is configured for this host`, which reads like a
# broken deploy and is really a one-character mismatch. `127.0.0.1:6100` does
# not match. Neither does the same name without `:6101`.
# ⚠️ VERIFY ON CRICHTON that `tailscale serve` forwards the original Host
#    rather than rewriting it to the loopback target.
#
# GUESS: mirrors evie-ui dev's split — the service binds a loopback port and
# tailscale serve publishes a DIFFERENT tailnet port. Do not "tidy" them into
# a matching pair; see CLAUDE.md on the :6000/:6001 split.
BUZZ_DOMAIN=__TAILNET_HOST__
RELAY_URL=wss://__TAILNET_HOST__:__HTTPS_PORT__
BUZZ_MEDIA_BASE_URL=https://__TAILNET_HOST__:__HTTPS_PORT__/media
BUZZ_MEDIA_SERVER_DOMAIN=__TAILNET_HOST__
BUZZ_CORS_ORIGINS=https://__TAILNET_HOST__:__HTTPS_PORT__

# ── Posture ─────────────────────────────────────────────────────────────────
# Closed relay. Tailnet-only is a network property, not an authorization one —
# the same lesson ADR-038 records for evie-ui, where "trust localhost" turned
# out to trust the whole tailnet and the LAN. Keep these true.
BUZZ_REQUIRE_AUTH_TOKEN=true
BUZZ_REQUIRE_RELAY_MEMBERSHIP=true
BUZZ_ALLOW_NIP_OA_AUTH=true
BUZZ_AUTO_MIGRATE=true
BUZZ_GIT_CONFORMANCE_PROBE=true
RUST_LOG=buzz_relay=info,buzz_db=info,buzz_auth=info,buzz_pubsub=info,tower_http=info

# ── Identity ────────────────────────────────────────────────────────────────
# Sam's owner pubkey. GUESS: the installer mints a fresh owner keypair and
# writes the secret to $BUZZ_RUNTIME_DIR/keys/owner.secret. If Sam already has
# a Nostr identity he wants to own this relay, replace this and delete that file.
RELAY_OWNER_PUBKEY=__OWNER_PUBKEY__

# ── Stable secrets ──────────────────────────────────────────────────────────
BUZZ_RELAY_PRIVATE_KEY=__RELAY_PRIVATE_KEY__
BUZZ_GIT_HOOK_HMAC_SECRET=__GIT_HOOK_HMAC_SECRET__
POSTGRES_DB=buzz
POSTGRES_USER=buzz
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
REDIS_PASSWORD=__REDIS_PASSWORD__
BUZZ_S3_ACCESS_KEY=__S3_ACCESS_KEY__
BUZZ_S3_SECRET_KEY=__S3_SECRET_KEY__
BUZZ_S3_BUCKET=buzz-media
# Bundled MinIO is path-style; deploy/compose/compose.yml pins this too.
BUZZ_S3_ADDRESSING_STYLE=path

# ── Ports (resolved from infra/port-registry.json — never hardcoded) ────────
BUZZ_HTTP_PORT=__RELAY_PORT__

# NIP-AB pairing sidecar (compose.pairing.yml): loopback bind on the host,
# fronted by a /pair path mount on the relay's https tailnet port.
BUZZ_PAIRING_PORT=__PAIRING_PORT__
# Advertised in the relay's NIP-11 doc. The desktop's pairing probe resolves
# this URL and the QR the phone scans carries it — same host:port as the main
# relay on purpose, so tailnet ACLs that already admit the phone to the relay
# admit the pairing traffic too. The /pair path disambiguates at the front
# door (tailscale serve mounts /pair → the sidecar's loopback port).
# NOTE: env_file on the relay service delivers this to the relay container —
# no compose change is needed on the relay side.
BUZZ_PAIRING_RELAY_URL=wss://__TAILNET_HOST__:__HTTPS_PORT__/pair

# Only used with compose.caddy.yml, which we do NOT use: crichton fronts this
# with `tailscale serve`, and the LAN Caddy uses caddy-cf, never plain caddy.
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# Dev override ports — only used with compose.dev.yml (adminer/prometheus).
POSTGRES_PORT=__POSTGRES_PORT__
REDIS_PORT=__REDIS_PORT__
MINIO_API_PORT=__MINIO_API_PORT__
MINIO_CONSOLE_PORT=__MINIO_CONSOLE_PORT__
ADMINER_PORT=__ADMINER_PORT__
PROMETHEUS_PORT=__PROMETHEUS_PORT__
